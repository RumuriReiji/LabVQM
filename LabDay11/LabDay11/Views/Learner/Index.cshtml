@model IEnumerable<Learner>
@{
    ViewData["Title"] = "Learners";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

<div class="ms-2 mx-2">
    <h1>Learner List</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên</th>
                <th>Họ</th>
                <th>Ngành</th>
                <th>Ngày Nhập Học</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.LearnerId</td>
                    <td>@item.FirstMidName</td>
                    <td>@item.LastName</td>
                    <td>@item.Major?.MajorName</td>
                    <td>@item.EnrollmentDate</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.LearnerId">Edit</a>|<a asp-action="Delete" asp-route-id="@item.LearnerId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Create" class="btn btn-primary">Create New Student</a>
</div>
