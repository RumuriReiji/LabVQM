@model IEnumerable<VuQuangMinh_231230843.Models.TaiSan>
<main class="main">
    <div class="container">
        <div class="banner"><img src="~/images/banner.jpg" alt="Banner" /></div>

        <!-- Tài sản mới nhập -->
        <div class="section-head">
            <h3>Vũ Quang Minh</h3>
            <a href="#">Xem tất cả &rsaquo;</a>
        </div>
        <div class="grid">
            @foreach (var item in Model)
            {
                <div class="asset-card">
                    <a href="#"><img src="~/images/@item.Anh" alt="" /></a>
                    <h2>@item.TenTs</h2>
                    <div class="asset-foot"><span class="price">@item.NguyenGia</span><button class="btn-buy">Chi tiết</button></div>
                    <a asp-controller="TaiSan" asp-action="Edit" asp-route-id="@item.MaTs" class="btn-buy">Sửa</a>

                </div>
            }
           
           
        </div>


    </div>
</main>