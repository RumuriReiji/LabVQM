@model IEnumerable<VuQuangMinh231230843.Models.Sach>
<main class="main">
    <div class="container">
        <div class="banner"><img src="images/banner.jpg" alt="Banner" /></div>

        <!-- Sách mới -->
        <div class="section-head">
            <h3>Vũ Quang Minh</h3>
            <a href="#">Xem tất cả &rsaquo;</a>
        </div>
        <div class="grid">
            @foreach(var item in Model)
            {
                <div class="book-card">
                    <a href="#"><img src="~/images/@item.Anh" alt="" /></a>
                    <h2>@item.TenSach</h2>
                    <div class="book-foot"><span class="price">@item.Gia</span><button class="btn-buy">Thêm vào giỏ</button></div>
                </div>
            }
            
            
        </div>
    </div>
</main>