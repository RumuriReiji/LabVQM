@model IEnumerable<Learner>

<table class="table">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Tên</th>
            <th>Họ</th>
            <th>Ngành</th>
            <th>Ngày Nhập Học</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LearnerId</td>
                <td>@item.FirstMidName</td>
                <td>@item.LastName</td>
                <td>@item.Major?.MajorName</td>
                <td>@item.EnrollmentDate</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.LearnerId">Edit</a>|<a asp-action="Delete" asp-route-id="@item.LearnerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Lab6: Pagination in partial view -->
<nav>
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.pageNum; i++)
        {
            <li class="page-item" page="@i"
                @(ViewBag.mid != null ? "mid=" + ViewBag.mid : "")
                @(ViewBag.keyword != null ? "keyword=" + ViewBag.keyword : "")>
                <a class="page-link">@i</a>
            </li>
        }
    </ul>
</nav>
