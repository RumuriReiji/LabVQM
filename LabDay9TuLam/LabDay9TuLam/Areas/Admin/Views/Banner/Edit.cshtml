@model LabDay9TuLam.Models.Banner

@{
    ViewData["Title"] = "Chỉnh sửa Banner";
}

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Chỉnh sửa Banner</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Banner" asp-action="Index">Quản lý Banner</a></li>
                    <li class="breadcrumb-item active">Chỉnh sửa</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- /.content-header -->

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">Cập nhật thông tin Banner</h3>
            </div>
            <!-- /.card-header -->
            <!-- form start -->
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label asp-for="Name">Tên Banner <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên banner" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status">Trạng thái</label>
                        <select asp-for="Status" class="form-control">
                            <option value="1">Hoạt động</option>
                            <option value="0">Không hoạt động</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Prioty">Độ ưu tiên</label>
                        <input asp-for="Prioty" type="number" class="form-control" placeholder="0" />
                        <span asp-validation-for="Prioty" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Image">Hình ảnh</label>
                        <input asp-for="Image" class="form-control" placeholder="Nhập đường dẫn hình ảnh (URL hoặc đường dẫn)" />
                        <span asp-validation-for="Image" class="text-danger"></span>
                        @if (!string.IsNullOrEmpty(Model?.Image))
                        {
                            <div class="mt-2">
                                <label class="d-block text-muted">Xem trước:</label>
                                <img src="@Model.Image" alt="@Model.Name" class="img-thumbnail" style="max-height: 100px; max-width: 200px; object-fit: cover;" onerror="this.onerror=null;this.style.display='none';" />
                            </div>
                        }
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả banner"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
                <!-- /.card-body -->

                <div class="card-footer">
                    <button type="submit" class="btn btn-info">
                        <i class="fas fa-save mr-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
        <!-- /.card -->
    </div>
</section>
<!-- /.content -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
