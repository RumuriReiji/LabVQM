@model LabDay9TuLam.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Xóa sản phẩm</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li>
                    <li class="breadcrumb-item active">Xóa</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- /.content-header -->

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-danger">
            <div class="card-header">
                <h3 class="card-title">Xác nhận xóa sản phẩm</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <h5><i class="icon fas fa-exclamation-triangle"></i> Cảnh báo!</h5>
                    Bạn có chắc chắn muốn xóa sản phẩm này không? Thao tác này không thể hoàn tác.
                </div>
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th style="width: 200px;">Mã sản phẩm (#)</th>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <th>Tên sản phẩm</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>Danh mục</th>
                            <td>@Model.Category?.Name</td>
                        </tr>
                        <tr>
                            <th>Giá</th>
                            <td>@(Model.Price.ToString("N0") + " đ")</td>
                        </tr>
                        <tr>
                            <th>Giá khuyến mãi</th>
                            <td>@(Model.SalePrice.ToString("N0") + " đ")</td>
                        </tr>
                        <tr>
                            <th>Trạng thái</th>
                            <td>
                                @if (Model.Status == 1)
                                {
                                    <span class="badge badge-success">Hiện</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Ẩn</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Ngày tạo</th>
                            <td>@Model.CreatedDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>Hình ảnh</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.Image))
                                {
                                    <span>@Model.Image</span>
                                }
                                else
                                {
                                    <span class="text-muted">Không có ảnh</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Mô tả</th>
                            <td>@Model.Description</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Xóa
                    </button>
                    <a asp-action="Index" class="btn btn-secondary ml-2">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </form>
            </div>
        </div>
    </div>
</section>
<!-- /.content -->
