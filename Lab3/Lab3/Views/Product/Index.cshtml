@using Lab3.Models

@{
    ViewData["Title"] = "Index";
    var categories = ViewBag.Categories as List<Category>;
    var products = ViewBag.Products as List<Product>;
}

<div class="row">

    <div class="col-md-3">
        <h3>DANH MỤC</h3>
        <ul class="list-group">
            <li class="list-group-item">
                <a asp-route="product_index">Tất cả</a>
            </li>
            @foreach (var category in categories)
            {
                <li class="list-group-item">
                    <a asp-route="product_index" asp-route-categoryId="@category.Id">
                        @category.Name
                    </a>
                </li>
            }
        </ul>
    </div>

 
    <div class="col-md-9">
        <h3>Danh sách sản phẩm</h3>
        <div class="row">
            @foreach (var item in products)
            {
                var category = categories.FirstOrDefault(c => c.Id == item.CategoryId);
                string categoryName = category != null ? category.Name : "";

                <div class="col-md-4">
                    <div class="thumbnail">
                        <img src="@item.Image" alt="@item.Name" style="width:100%; height:380px; object-fit:cover;">
                        <div class="caption">
                            <h4>@item.Name</h4>
                            <p><strong>Danh mục:</strong> @categoryName</p>
                            <p><strong>Giá gốc:</strong> @item.Price.ToString("N0")</p>
                            <p><strong>Giá mới:</strong> @item.SalePrice.ToString("N0")</p>
                            <p>
                                <a asp-route="product_detail" asp-route-id="@item.Id" class="btn btn-success btn-block">Chi tiết</a>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>