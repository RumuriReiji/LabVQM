@model LabDay9TuLam.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Xác nhận xóa danh mục</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Danh mục</a></li>
                    <li class="breadcrumb-item active">Xóa</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- /.content-header -->

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-danger">
            <div class="card-header">
                <h3 class="card-title">Bạn có chắc chắn muốn xóa danh mục này?</h3>
            </div>
            <!-- /.card-header -->
            <div class="card-body">
                <div class="callout callout-danger">
                    <h5><i class="fas fa-exclamation-triangle mr-1"></i> Chú ý!</h5>
                    <p class="mb-0">Hành động này không thể hoàn tác. Danh mục sẽ bị xóa vĩnh viễn khỏi hệ thống.</p>
                </div>

                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th style="width: 200px;" class="bg-light">Mã danh mục (#)</th>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Tên danh mục</th>
                            <td class="font-weight-bold">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Trạng thái</th>
                            <td>
                                @if (Model.Status == 1)
                                {
                                    <span class="badge badge-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Không hoạt động</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Ngày tạo</th>
                            <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Hình ảnh</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.Image))
                                {
                                    <img src="@Model.Image" alt="@Model.Name" class="img-thumbnail" style="max-height: 80px;" />
                                }
                                else
                                {
                                    <span class="text-muted small">Không có</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Mô tả</th>
                            <td>@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- /.card-body -->

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="card-footer">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash mr-1"></i> Xác nhận xóa
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
        <!-- /.card -->
    </div>
</section>
<!-- /.content -->
