@model IEnumerable<Lab4_TuLam.Models.Product>
@{
    ViewData["Title"] = "Home Page";
}


<h4 class="bg-primary text-white" style="padding: 10px; margin-top: 0;">Sản phẩm mới nhất</h4>

<div class="row">
    @foreach (var item in Model)
    {
       
        <div class="col-md-4 col-sm-6" style="margin-bottom: 20px;">

           
            <div class="thumbnail">

               
                <img src="@item.ImageUrl" class="img-responsive" alt="@item.Name" style="width: 100%; height: auto;">

                <div class="caption text-center">
                    <h6 style="font-weight: bold; min-height: 40px;">@item.Name</h6>
                </div>

            </div>
        </div>
    }
</div>

@await Component.InvokeAsync("HotProduct")